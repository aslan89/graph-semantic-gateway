APP_NAME="Graph Semantic AI Gateway"
APP_ENV="development"

# Deney ve kıyaslama modları: hybrid | vector_only | passthrough
GATEWAY_MODE="hybrid"

# Dış LLM API Ayarları (Anahtar boş bırakılırsa yerel simülasyon modu çalışır)
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
DEFAULT_LLM_MODEL="gpt-4o-mini"
LLM_TIMEOUT_SECONDS=30.0