
APP_NAME="Graph Semantic AI Gateway"
APP_ENV="development"

# Deney ve kıyaslama modları: hybrid | vector_only | passthrough
GATEWAY_MODE="hybrid"

# Katman 2: Özellik Çıkarım Modelleri
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
SPACY_MODEL_NAME="en_core_web_sm"

# Katman 3: Neo4j Graf Veritabanı Ayarları
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password123"
BASE_SIMILARITY_THRESHOLD=0.80

# Katman 4: Redis Önbellek Ayarları
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL_SECONDS=86400

# Dış LLM API Ayarları
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
DEFAULT_LLM_MODEL="gpt-4o-mini"
LLM_TIMEOUT_SECONDS=30.0